# =============================================================================
# containers/rnaseq.def
# =============================================================================
# Apptainer container definition file.
# Installs all bioinformatics tools needed by the pipeline so it runs
# identically on any HPC cluster regardless of what modules are available.
#
# Build with:
#   apptainer build containers/rnaseq.sif containers/rnaseq.def
# =============================================================================

Bootstrap: docker
From: ubuntu:22.04

%labels
    Author      Rahul Dey
    Description RNAseq pipeline container for T. congolense analysis
    Tools       fastqc, bowtie2, samtools, bedtools, snakemake

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y \
        fastqc      \
        bowtie2     \
        samtools    \
        bedtools    \
        python3     \
        python3-pip \
        unzip       \
        wget        \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    pip3 install --no-cache-dir snakemake

%environment
    export PATH="/usr/bin:/usr/local/bin:$PATH"
    export LC_ALL=C

%runscript
    exec "$@"
